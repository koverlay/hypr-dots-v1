{
    "layer": "top",
    "position": "top",

    // Waybar появляется поверх окон и не перестраивает тайлинг.
    // Для твоего toggle-режима это намного приятнее.
    "exclusive": true,

    "height": 30,

    "margin-top": 6,
    "margin-left": 8,
    "margin-right": 8,

    "spacing": 0,

    // -------------------------------------------------------------------------
    // Layout
    // -------------------------------------------------------------------------

    "modules-left": [
        "custom/arch",
        "hyprland/workspaces",
        "custom/separator",
        "hyprland/window"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "pulseaudio",
        "custom/separator",
        "network",
        "custom/separator",
        "bluetooth",
        "custom/separator",
        "cpu",
        "custom/separator",
        "memory",
        "custom/separator",
        "temperature",
        "custom/separator",
        "battery",
        "tray"
    ],

    // -------------------------------------------------------------------------
    // Common
    // -------------------------------------------------------------------------

    "custom/separator": {
        "format": "·",
        "tooltip": false
    },

    "custom/arch": {
        "format": "󰣇",
        "tooltip": false
    },

    // -------------------------------------------------------------------------
    // Hyprland
    // -------------------------------------------------------------------------

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "warp-on-scroll": false,
        "format": "{name}",
        "on-click": "activate"
    },

    "hyprland/window": {
        "format": "{class}",
        "max-length": 32,
        "tooltip": false,
        "separate-outputs": true
    },

    // -------------------------------------------------------------------------
    // Clock
    // -------------------------------------------------------------------------

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%A, %d %B %Y}",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",

        "calendar": {
            "mode": "month",
            "on-scroll": 1
        }
    },

    // -------------------------------------------------------------------------
    // Audio
    // -------------------------------------------------------------------------

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰖁",

        "format-icons": {
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },

        "on-click": "GTK_THEME=Adwaita-dark pavucontrol",
        "tooltip-format": "{desc} — {volume}%"
    },

    // -------------------------------------------------------------------------
    // Network
    // -------------------------------------------------------------------------

    "network": {
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀 Wired",
        "format-disconnected": "󰤭",

        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",

        "on-click": "kitty --title nmtui -e nmtui",
        "max-length": 14
    },

    // -------------------------------------------------------------------------
    // Bluetooth
    // -------------------------------------------------------------------------

    "bluetooth": {
        "format": "󰂯",
        "format-connected": "󰂱 {device_alias}",
        "tooltip-format": "{num_connections} connected"
    },

    // -------------------------------------------------------------------------
    // Monitoring
    // -------------------------------------------------------------------------

    "cpu": {
        "format": "󰻠 {usage}%",
        "interval": 3,
        "tooltip": false
    },

    "memory": {
        "format": "󰍛 {percentage}%",
        "interval": 5,
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
    },

    "temperature": {
        "interval": 10,
        "critical-threshold": 85,
        "format": "󰔏 {temperatureC}°",
        "format-critical": "󰸁 {temperatureC}°"
    },

    // -------------------------------------------------------------------------
    // Battery
    // -------------------------------------------------------------------------

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },

        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",

        "format-icons": [
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],

        "tooltip-format": "{capacity}% — {timeTo}"
    },

    // -------------------------------------------------------------------------
    // Tray
    // -------------------------------------------------------------------------

    "tray": {
        "spacing": 8,
        "icon-size": 14
    }
}
