# -----------------------------------------------------------------------------
# ble.sh — Fish-like monochrome theme
# -----------------------------------------------------------------------------

bleopt highlight_syntax=1
bleopt highlight_filename=1
bleopt highlight_variable=1

# Normal syntax / parameters
ble-face -s syntax_default           fg=#9a9a9a
ble-face -s syntax_quoted            fg=#9a9a9a
ble-face -s syntax_quotation         fg=#9a9a9a
ble-face -s syntax_escape            fg=#9a9a9a
ble-face -s syntax_expr              fg=#9a9a9a
ble-face -s syntax_varname           fg=#9a9a9a
ble-face -s syntax_delimiter         fg=#9a9a9a
ble-face -s syntax_param_expansion   fg=#9a9a9a
ble-face -s syntax_function_name     fg=#b0b0b0
ble-face -s syntax_glob              fg=#9a9a9a
ble-face -s syntax_brace             fg=#9a9a9a
ble-face -s syntax_tilde             fg=#9a9a9a
ble-face -s syntax_comment           fg=#9a9a9a

# Unknown / invalid
ble-face -s syntax_command           fg=#a87070
ble-face -s syntax_error             fg=#a87070
ble-face -s command_suffix           fg=#a87070
ble-face -s command_suffix_new       fg=#a87070

# Valid commands
ble-face -s command_builtin          fg=#b0b0b0
ble-face -s command_builtin_dot      fg=#b0b0b0
ble-face -s command_alias            fg=#b0b0b0
ble-face -s command_function         fg=#b0b0b0
ble-face -s command_file             fg=#b0b0b0
ble-face -s command_keyword          fg=#b0b0b0
ble-face -s command_jobs             fg=#b0b0b0
ble-face -s command_directory        fg=#b0b0b0,underline

# Options / arguments
ble-face -s argument_option          fg=#9a9a9a
ble-face -s argument_error           fg=#a87070

# Existing paths
ble-face -s filename_directory       fg=#9a9a9a,underline
ble-face -s filename_link            fg=#9a9a9a,underline
ble-face -s filename_executable      fg=#9a9a9a,underline
ble-face -s filename_other           fg=#9a9a9a,underline
ble-face -s filename_socket          fg=#9a9a9a,underline
ble-face -s filename_pipe            fg=#9a9a9a,underline
ble-face -s filename_character       fg=#9a9a9a,underline
ble-face -s filename_block           fg=#9a9a9a,underline
ble-face -s filename_ls_colors       fg=#9a9a9a,underline

# Broken/problematic paths
ble-face -s filename_orphan          fg=#a87070
ble-face -s filename_warning         fg=#a87070

# Suggestions
ble-face -s auto_complete            fg=#777777
bleopt complete_auto_delay=100
bleopt complete_auto_complete_opts=syntax-disabled

# History
bleopt history_share=1

# fzf
ble-import -d integration/fzf-completion
ble-import -d integration/fzf-key-bindings

# Ctrl+C
ble-bind -m emacs -f 'C-c' discard-line

# No annoying unbound-key popup/bell
bleopt decode_error_kseq_vbell=
bleopt decode_error_kseq_abell=

# Cursor
bleopt term_cursor_external=5
blehook/eval-after-load keymap_emacs 'ble-bind -m emacs --cursor 5'
